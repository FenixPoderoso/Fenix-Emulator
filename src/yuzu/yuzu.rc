#include "winresrc.h"
/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
// QT requires that the default application icon is named IDI_ICON1

IDI_ICON1               ICON                    "../../dist/fenix.ico"


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

0                       RT_MANIFEST             "../../dist/yuzu.manifest"

1 VERSIONINFO
 FILEVERSION 0,0,1,0
 PRODUCTVERSION 0,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "FenixPoderoso\0"
   VALUE "FileDescription", "Fenix Emulator\0"
   VALUE "FileVersion", "0.0.1\0"
   VALUE "InternalName", "fenix\0"
   VALUE "OriginalFilename", "fenix.exe\0"
   VALUE "ProductName", "Fenix Emulator\0"
   VALUE "ProductVersion", "0.0.1\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
